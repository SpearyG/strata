option(STRATA_WARNINGS_AS_ERRORS "Treat project warnings as errors" ON)
option(STRATA_ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(STRATA_ENABLE_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(STRATA_ENABLE_TSAN "Enable ThreadSanitizer (separate build)" OFF)
option(STRATA_ENABLE_LTO "Enable interprocedural optimization" OFF)
option(STRATA_NATIVE "Optimize for the build machine CPU (nonportable binaries)" OFF)
option(STRATA_FORCE_PACK_FALLBACK "Exercise tuple fallback for pack indexing" OFF)
if(STRATA_ENABLE_TSAN AND (STRATA_ENABLE_ASAN OR STRATA_ENABLE_UBSAN))
  message(FATAL_ERROR "TSan must be used in a separate build")
endif()

function(strata_options target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /EHsc)
    if(STRATA_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE /WX)
    endif()
    if(STRATA_ENABLE_ASAN OR STRATA_ENABLE_UBSAN OR STRATA_ENABLE_TSAN)
      message(FATAL_ERROR "Sanitizer presets are supported with GCC/Clang on Linux")
    endif()
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow)
    if(STRATA_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
    set(sanitizers "")
    if(STRATA_ENABLE_ASAN)
      list(APPEND sanitizers address)
    endif()
    if(STRATA_ENABLE_UBSAN)
      list(APPEND sanitizers undefined)
    endif()
    if(STRATA_ENABLE_TSAN)
      list(APPEND sanitizers thread)
    endif()
    if(sanitizers)
      list(JOIN sanitizers "," sanitizer_flags)
      target_compile_options(${target} PRIVATE -fsanitize=${sanitizer_flags} -fno-omit-frame-pointer)
      get_target_property(target_type ${target} TYPE)
      if(target_type STREQUAL "STATIC_LIBRARY")
        # A static archive cannot link its instrumentation runtime itself.
        target_link_options(${target} INTERFACE -fsanitize=${sanitizer_flags})
      else()
        target_link_options(${target} PRIVATE -fsanitize=${sanitizer_flags})
      endif()
    endif()
    if(STRATA_NATIVE)
      target_compile_options(${target} PRIVATE -march=native)
    endif()
  endif()
  if(STRATA_ENABLE_LTO)
    set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
  endif()
endfunction()
