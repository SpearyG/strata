file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
set(journal "${TEST_DIRECTORY}/integration.strata")
execute_process(COMMAND "${STRATA_EXE}" --events 10003 --series 32 --workers 2 --producers 3 --journal "${journal}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "record/run failed: ${errors}")
endif()
string(JSON count GET "${output}" processed)
if(NOT count EQUAL 10003)
  message(FATAL_ERROR "record source processed ${count} events")
endif()
execute_process(COMMAND "${STRATA_EXE}" --series 32 --workers 2 --replay "${journal}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
file(REMOVE "${journal}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "replay failed: ${errors}")
endif()
string(JSON count GET "${output}" run processed)
string(JSON tail GET "${output}" truncated_tail)
if(NOT count EQUAL 10003 OR tail)
  message(FATAL_ERROR "replay count/tail invariant failed: ${output}")
endif()
